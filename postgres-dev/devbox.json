{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": {
    "meson": "1.9.1",
    "ninja": "1.13.1",
    "flex":  "2.6.4",
    "bison": "3.8.2",
    "gcc":   "15.2.0",
    "readline": {
      "version": "8.3p3",
      "outputs": ["dev"]
    },
    "openssl": "3.6.0",
    "path:../hackorum-patch#default": "",
    "perl":                           "5.42.0",
    // perl packages must be built against the same perl version as the `perl` package above
    "perl5Packages.IPCRun":           "20231003.0",
    "pkgconfig":                      "latest"
  },
  "env": {
    "GIT_REPO_URLS": "https://github.com/postgres/postgres",
    "GIT_CLONE_DIR": "$DEVBOX_PROJECT_ROOT",
    "CC":            "gcc",
    "CXX":           "g++"
  },
  "shell": {
    "init_hook": [
      "source $DEVBOX_PROJECT_ROOT/env.sh"
    ],
    "scripts": {
      "setup": [
        "meson setup $PG_BUILDDIR $DEVBOX_WD --prefix=$PG_PREFIX -Dpgport=$PGPORT --debug -Dinjection_points=true --buildtype=${PG_BUILDTYPE:-debug} \"$@\""
      ],
      "build": [
        "ninja -C $PG_BUILDDIR install \"$@\""
      ],
      "clean-build": [
        "rm -rf $PG_BUILDDIR"
      ],
      "clean-data": [
        "rm -rf $PGDATA"
      ],
      "initdb": [
        "$PG_PREFIX/bin/initdb -D $PGDATA"
      ],
      "psql": [
        "$PG_PREFIX/bin/psql -d postgres -p $PGPORT"
      ],
      "start": [
        "$PG_PREFIX/bin/pg_ctl start -D $PGDATA -l $PGDATA/postgres.log"
      ],
      "stop": [
        "$PG_PREFIX/bin/pg_ctl stop -m fast"
      ],
      "patch": [
        "cd $GIT_CLONE_DIR/postgres && hackorum-patch --worktree=yes \"$@\""
      ],
      "test": [
        "meson test -C $PG_BUILDDIR -q --print-errorlogs \"$@\""
      ]
    }
  },
  "include": [
    "path:../git-clone"
  ]
}
